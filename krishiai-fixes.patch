/**
 * Provider Cooldown / Circuit Breaker
 *
 * Tracks per-provider failure rates and 429 (rate-limited) responses, and
 * temporarily removes a provider from rotation when it is being rate-limited
 * by its upstream vendor.
 *
 * Why we need this:
 *  - Gemini / OpenRouter / Groq all have their own per-key rate limits.
 *  - The previous code simply fell through to the next provider on ANY
 *    failure, including 429s — which means we'd burn through the entire
 *    fallback chain in a single second if a provider was rate-limiting us.
 *  - This module records when a provider returned 429 + how long to wait
 *    (from `Retry-After` header or exponential backoff), and short-circuits
 *    future calls to that provider until the cooldown expires.
 *
 * Memory: O(providers) — trivial. Each provider has one state record.
 *
 * Edge-runtime safe: pure in-memory Map, no timers, no Node APIs.
 */

type ProviderName = string;

interface CooldownState {
  /** Epoch ms until which this provider should NOT be called. */
  cooldownUntil: number;
  /** Last reason for cooldown (for telemetry / logs). */
  reason: string;
  /** Consecutive 429s seen — used for exponential backoff escalation. */
  consecutive429s: number;
  /** Last HTTP status observed (or -1 for network errors). */
  lastStatus: number;
  /** Last update time. */
  updatedAt: number;
}

const states = new Map<ProviderName, CooldownState>();

/** Default backoff schedule (ms) indexed by consecutive-429 count.
 *  Caps at 5 minutes — we never permanently disable a provider. */
const BACKOFF_MS = [
  5_000,    // 1st 429: 5s
  15_000,   // 2nd: 15s
  30_000,   // 3rd: 30s
  60_000,   // 4th: 60s
  120_000,  // 5th+: 2 min
];

const MAX_COOLDOWN_MS = 5 * 60_000; // 5 min hard cap

/**
 * Returns true if the provider is currently in cooldown and should be
 * skipped. Logs the reason via console.warn for observability.
 */
export function isInCooldown(provider: ProviderName): boolean {
  const state = states.get(provider);
  if (!state) return false;
  if (Date.now() >= state.cooldownUntil) return false;
  return true;
}

/**
 * Returns the remaining cooldown in ms (0 if none).
 */
export function cooldownRemainingMs(provider: ProviderName): number {
  const state = states.get(provider);
  if (!state) return 0;
  return Math.max(0, state.cooldownUntil - Date.now());
}

/**
 * Mark a provider as rate-limited (429). Applies either the upstream
 * `Retry-After` value (if provided and sane) or an exponential backoff
 * based on the recent consecutive-429 count.
 */
export function markRateLimited(
  provider: ProviderName,
  opts?: { retryAfterSeconds?: number; status?: number },
): void {
  const now = Date.now();
  const prev = states.get(provider);
  const consecutive = (prev?.consecutive429s ?? 0) + 1;

  let cooldownMs: number;
  let reason: string;

  const retryAfter = opts?.retryAfterSeconds;
  if (retryAfter && retryAfter > 0 && retryAfter <= 300) {
    // Respect upstream Retry-After, but cap at 5 min
    cooldownMs = Math.min(retryAfter * 1000, MAX_COOLDOWN_MS);
    reason = `429 (Retry-After=${retryAfter}s)`;
  } else {
    // Exponential backoff based on consecutive 429s
    const idx = Math.min(consecutive - 1, BACKOFF_MS.length - 1);
    cooldownMs = Math.min(BACKOFF_MS[idx], MAX_COOLDOWN_MS);
    reason = `429 (backoff=${cooldownMs}ms, consecutive=${consecutive})`;
  }

  states.set(provider, {
    cooldownUntil: now + cooldownMs,
    reason,
    consecutive429s: consecutive,
    lastStatus: opts?.status ?? 429,
    updatedAt: now,
  });

  console.warn(`[providerCooldown] ${provider} cooldown ${cooldownMs}ms — ${reason}`);
}

/**
 * Mark a provider as having a transient failure (network error, 5xx, etc.).
 * Lighter than a 429: a single failure does NOT trigger cooldown — we only
 * cool down after 3 consecutive failures to avoid flapping.
 */
export function markFailure(
  provider: ProviderName,
  opts?: { status?: number; reason?: string },
): void {
  const now = Date.now();
  const prev = states.get(provider);

  // Network errors and 5xx are transient — don't punish a single blip
  const status = opts?.status ?? -1;
  if (status === 429) {
    markRateLimited(provider, opts);
    return;
  }

  // For other failures, increment a "soft" counter (we reuse consecutive429s
  // but with smaller cooldown). After 3 consecutive failures, short cooldown.
  const consecutive = (prev?.consecutive429s ?? 0) + 1;
  if (consecutive >= 3) {
    states.set(provider, {
      cooldownUntil: now + 15_000, // 15s soft cooldown
      reason: `consecutive failures (${consecutive}) — ${opts?.reason ?? 'unknown'}`,
      consecutive429s: consecutive,
      lastStatus: status,
      updatedAt: now,
    });
    console.warn(`[providerCooldown] ${provider} soft cooldown 15s — ${consecutive} consecutive failures`);
  } else {
    states.set(provider, {
      cooldownUntil: 0,
      reason: opts?.reason ?? `failure #${consecutive}`,
      consecutive429s: consecutive,
      lastStatus: status,
      updatedAt: now,
    });
  }
}

/**
 * Mark a provider as healthy (called after a successful response).
 * Resets the consecutive-failure counter.
 */
export function markSuccess(provider: ProviderName): void {
  const prev = states.get(provider);
  if (!prev || prev.consecutive429s === 0) return;
  states.set(provider, {
    cooldownUntil: 0,
    reason: 'recovered',
    consecutive429s: 0,
    lastStatus: 200,
    updatedAt: Date.now(),
  });
}

/**
 * Snapshot all provider states — used for the /api/dashboard endpoint and
 * for emitting telemetry headers on AI responses.
 */
export function getProviderStates(): Array<{
  provider: string;
  inCooldown: boolean;
  remainingMs: number;
  reason: string;
  consecutive429s: number;
  lastStatus: number;
}> {
  const now = Date.now();
  return Array.from(states.entries()).map(([provider, s]) => ({
    provider,
    inCooldown: now < s.cooldownUntil,
    remainingMs: Math.max(0, s.cooldownUntil - now),
    reason: s.reason,
    consecutive429s: s.consecutive429s,
    lastStatus: s.lastStatus,
  }));
}

/**
 * Parse a `Retry-After` header value. Returns seconds, or undefined if
 * the header is missing/invalid. Handles both delta-seconds and HTTP-date
 * formats per RFC 7231.
 */
export function parseRetryAfter(headerValue: string | null | undefined): number | undefined {
  if (!headerValue) return undefined;
  const trimmed = headerValue.trim();

  // Try integer seconds first
  const asNum = Number(trimmed);
  if (Number.isFinite(asNum) && asNum >= 0) return Math.floor(asNum);

  // Try HTTP date
  const asDate = Date.parse(trimmed);
  if (!Number.isNaN(asDate)) {
    const diffSec = Math.ceil((asDate - Date.now()) / 1000);
    return diffSec > 0 ? diffSec : 0;
  }

  return undefined;
}

