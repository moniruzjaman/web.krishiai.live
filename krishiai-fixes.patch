/**
 * In-memory sliding-window rate limiter.
 *
 * Used to throttle anonymous (not-logged-in) traffic on a per-IP / per-key basis
 * before any AI provider call is made. This protects the platform from abuse
 * even when Supabase auth is not in play (the Supabase-backed `quota.ts` only
 * enforces limits for authenticated users — anonymous users were previously
 * unlimited, which is the rate-limit hole we close here).
 *
 * Design notes:
 *  - Pure in-memory Map. Each entry stores an array of request timestamps.
 *  - Sliding window: on every check, drop timestamps older than `windowMs`
 *    and reject if the remaining count >= `maxRequests`.
 *  - Self-pruning: empty buckets are deleted to prevent memory growth.
 *  - Edge-runtime safe: no Node-specific APIs, no setTimeout leaks.
 *
 * Limits are conservative for a free hobby-tier deployment. Tune via env if
 * needed: RATE_LIMIT_PER_MINUTE_ANON, RATE_LIMIT_PER_MINUTE_DIAGNOSE.
 */

interface Bucket {
  timestamps: number[];
}

const buckets = new Map<string, Bucket>();

export interface RateLimitOptions {
  /** Identifier for the caller (IP, user-id, session-id, etc.) */
  key: string;
  /** Bucket namespace — e.g. "anon:diagnose", "anon:chat". Lets us have
   *  different limits per feature without colliding keys. */
  namespace: string;
  /** Maximum requests allowed within the window. */
  maxRequests: number;
  /** Window length in milliseconds. */
  windowMs: number;
}

export interface RateLimitResult {
  allowed: boolean;
  remaining: number;
  /** Epoch ms when the oldest request in the window will expire — useful
   *  for setting `Retry-After` headers. */
  retryAfterMs: number;
  /** Total requests in current window (after this attempt). */
  current: number;
  /** Configured max for this bucket. */
  limit: number;
}

/**
 * Attempt to consume one slot from the rate-limit bucket.
 * Returns `allowed: true` if the request may proceed.
 */
export function checkRateLimit(opts: RateLimitOptions): RateLimitResult {
  const compositeKey = `${opts.namespace}::${opts.key}`;
  const now = Date.now();
  const cutoff = now - opts.windowMs;

  let bucket = buckets.get(compositeKey);
  if (!bucket) {
    bucket = { timestamps: [] };
    buckets.set(compositeKey, bucket);
  }

  // Drop expired timestamps (sliding window)
  bucket.timestamps = bucket.timestamps.filter(t => t > cutoff);

  const current = bucket.timestamps.length;
  if (current >= opts.maxRequests) {
    // Oldest surviving timestamp = when a slot frees up
    const oldest = bucket.timestamps[0] ?? now;
    return {
      allowed: false,
      remaining: 0,
      retryAfterMs: Math.max(0, oldest + opts.windowMs - now),
      current,
      limit: opts.maxRequests,
    };
  }

  // Consume a slot
  bucket.timestamps.push(now);
  return {
    allowed: true,
    remaining: opts.maxRequests - bucket.timestamps.length,
    retryAfterMs: 0,
    current: bucket.timestamps.length,
    limit: opts.maxRequests,
  };
}

/**
 * Peek at the bucket without consuming a slot — useful for diagnostics
 * and for emitting X-RateLimit headers on successful responses.
 */
export function peekRateLimit(namespace: string, key: string): { current: number; remaining: number } | null {
  const compositeKey = `${namespace}::${key}`;
  const bucket = buckets.get(compositeKey);
  if (!bucket) return null;
  return {
    current: bucket.timestamps.length,
    remaining: Math.max(0, 0 - bucket.timestamps.length), // caller must know the limit
  };
}

/**
 * Periodic GC — call from a long-lived process or after N requests to
 * prune empty buckets. Cheap to call on every check.
 */
export function gcRateLimitBuckets(): number {
  let pruned = 0;
  for (const [k, b] of buckets.entries()) {
    if (b.timestamps.length === 0) {
      buckets.delete(k);
      pruned++;
    }
  }
  return pruned;
}

// ── Tunable per-feature limits (env-driven for ops flexibility) ─────────────

function envInt(name: string, fallback: number): number {
  const raw = process.env[name];
  if (!raw) return fallback;
  const n = Number(raw);
  return Number.isFinite(n) && n > 0 ? Math.floor(n) : fallback;
}

/** Anonymous requests per minute to /api/diagnose. */
export const ANON_DIAGNOSE_RPM = envInt('RATE_LIMIT_PER_MINUTE_DIAGNOSE', 8);

/** Anonymous requests per minute to /api/chat. */
export const ANON_CHAT_RPM = envInt('RATE_LIMIT_PER_MINUTE_CHAT', 12);

/** Authenticated-user requests per minute (defense-in-depth even though
 *  Supabase quota also enforces daily limits). */
export const AUTH_RPM = envInt('RATE_LIMIT_PER_MINUTE_AUTH', 30);

/** Window length (1 minute default). */
export const WINDOW_MS = envInt('RATE_LIMIT_WINDOW_MS', 60_000);

/**
 * Resolve client IP from a Next.js Request. Handles Vercel's forwarding
 * headers and falls back to a synthetic key if none can be determined
 * (so we still throttle *something*).
 */
export function resolveClientIp(req: Request): string {
  const headers = req.headers;
  // Vercel: "x-forwarded-for" is the canonical header.
  const xff = headers.get('x-forwarded-for');
  if (xff) {
    // Take the first IP (closest to the client) — xff is "client, proxy1, proxy2"
    const first = xff.split(',')[0]?.trim();
    if (first) return first;
  }
  // Some CDNs use these
  const realIp = headers.get('x-real-ip');
  if (realIp) return realIp.trim();
  const cfIp = headers.get('cf-connecting-ip');
  if (cfIp) return cfIp.trim();
  // Last resort — synthesize so the limiter still does *something*
  return 'unknown-ip';
}

/**
 * Convert a millisecond duration into an integer number of seconds,
 * rounded up, suitable for a `Retry-After` HTTP header.
 */
export function msToRetryAfterSeconds(ms: number): number {
  return Math.max(1, Math.ceil(ms / 1000));
}

