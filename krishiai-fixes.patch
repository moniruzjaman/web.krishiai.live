/**
 * Tiny LRU-style TTL cache for AI request deduplication.
 *
 * Use case: when a user double-clicks the "Diagnose" button, or when two
 * users in different sessions submit an identical diagnosis payload within
 * a short window, we don't want to burn two AI provider calls.
 *
 * Design:
 *  - Pure in-memory Map. Keys are SHA-ish strings (caller-supplied).
 *  - Each entry has an explicit expiresAt timestamp.
 *  - On read, expired entries are evicted.
 *  - Max entries bounded (default 256) — when full, oldest entries evicted.
 *
 * Edge-runtime safe. No timers, no Node-specific APIs.
 *
 * Tunable via env: AI_CACHE_TTL_MS (default 60_000), AI_CACHE_MAX (default 256).
 */

interface CacheEntry<V> {
  value: V;
  expiresAt: number;
  /** Insertion order — used for LRU eviction. */
  seq: number;
}

const store = new Map<string, CacheEntry<unknown>>();
let seqCounter = 0;

function envInt(name: string, fallback: number): number {
  const raw = process.env[name];
  if (!raw) return fallback;
  const n = Number(raw);
  return Number.isFinite(n) && n > 0 ? Math.floor(n) : fallback;
}

const TTL_MS = envInt('AI_CACHE_TTL_MS', 60_000);
const MAX_ENTRIES = envInt('AI_CACHE_MAX', 256);

/**
 * Look up a cached value. Returns undefined if missing or expired.
 * Side-effect: evicts the entry if expired.
 */
export function cacheGet<V>(key: string): V | undefined {
  const entry = store.get(key);
  if (!entry) return undefined;
  if (Date.now() >= entry.expiresAt) {
    store.delete(key);
    return undefined;
  }
  // Bump LRU seq so this entry is less likely to be evicted next.
  entry.seq = ++seqCounter;
  return entry.value as V;
}

/**
 * Insert a value with a given TTL (default = TTL_MS from env).
 * Evicts oldest entries when the cache is full.
 */
export function cacheSet<V>(key: string, value: V, ttlMs: number = TTL_MS): void {
  // Evict expired entries first (cheap GC)
  if (store.size >= MAX_ENTRIES) {
    gc();
    // If still full after GC, evict the single oldest entry
    if (store.size >= MAX_ENTRIES) {
      let oldestKey: string | null = null;
      let oldestSeq = Infinity;
      for (const [k, v] of store.entries()) {
        if (v.seq < oldestSeq) {
          oldestSeq = v.seq;
          oldestKey = k;
        }
      }
      if (oldestKey) store.delete(oldestKey);
    }
  }

  store.set(key, {
    value,
    expiresAt: Date.now() + ttlMs,
    seq: ++seqCounter,
  });
}

/** Garbage-collect expired entries. Returns count pruned. */
export function gc(): number {
  let pruned = 0;
  const now = Date.now();
  for (const [k, v] of store.entries()) {
    if (now >= v.expiresAt) {
      store.delete(k);
      pruned++;
    }
  }
  return pruned;
}

/** Stats for /api/dashboard. */
export function cacheStats(): { size: number; maxEntries: number; ttlMs: number } {
  return { size: store.size, maxEntries: MAX_ENTRIES, ttlMs: TTL_MS };
}

/**
 * Build a stable cache key from a structured payload.
 * Uses a tiny FNV-1a hash — fast, no dependencies, good enough for
 * dedup purposes (we don't need cryptographic strength).
 *
 * Input is JSON-stringified with sorted keys for determinism.
 */
export function buildCacheKey(parts: unknown[]): string {
  const json = stableJson(parts);
  return 'k:' + fnv1a(json);
}

function stableJson(v: unknown): string {
  if (v === null || typeof v !== 'object') return JSON.stringify(v);
  if (Array.isArray(v)) return '[' + v.map(stableJson).join(',') + ']';
  const obj = v as Record<string, unknown>;
  const keys = Object.keys(obj).sort();
  return '{' + keys.map(k => JSON.stringify(k) + ':' + stableJson(obj[k])).join(',') + '}';
}

function fnv1a(str: string): string {
  // 32-bit FNV-1a, returned as base36 string
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    // h * 16777619, keep as unsigned 32-bit
    h = (h + ((h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24))) >>> 0;
  }
  return h.toString(36);
}

