# KrishiAI — Environment Variables
# z-ai-web-dev-sdk is always available (no key needed)

# Optional: CABI Diagnosis AI Providers (for hybrid fallback)
# Google Gemini API Key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API Key — https://openrouter.ai/keys
OPENROUTER_API_KEY=
