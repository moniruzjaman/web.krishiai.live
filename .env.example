# ═══════════════════════════════════════════════════════════════════════════════
# KrishiAI Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Google Gemini API Key — Primary AI provider for diagnosis & chat
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key — Fast text-only fallback provider
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API Key — Vision-capable fallback provider
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Cloudflare Workers AI ─────────────────────────────────────────────────────
# Cloudflare Account ID — Found in CF dashboard sidebar
CF_ACCOUNT_ID=

# Cloudflare API Token — With Workers AI permissions
# Generate at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# Cloudflare AI Gateway URL — Fast path for AI inference
# Format: https://gateway.ai.cloudflare.com/v1/{CF_ACCOUNT_ID}/{GATEWAY_NAME}
CF_GATEWAY_URL=

# ── Optional: Vercel Deployment ───────────────────────────────────────────────
# VERCEL_URL=web.krishiai.live
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
