# ═══════════════════════════════════════════════════════════════════════════════
# KrishiAI Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Google Gemini API Key — Primary AI provider (Gemini 2.5 Flash)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key — Fast text-only fallback provider
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API Key — Vision-capable fallback provider
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# KrishiAI Gateway token — last-resort free fallback for chat only, after
# Gemini/OpenRouter/Groq. Must match the KRISHI_API_TOKEN secret set on the
# krishi-ai-gateway Cloudflare Worker (api.krishiai.live). Optional: chat
# just skips this tier and falls to offline text if unset.
KRISHI_GATEWAY_TOKEN=

# ── Web Push (PWA notifications) ──────────────────────────────────────────────
# Generate a free VAPID key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@krishiai.live

# Service-role key (server-only) — used by /api/push/send to read subscriptions
# and bypass RLS. Get from Supabase project settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the /api/push/send cron endpoint
CRON_SECRET=

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Turso (LibSQL/SQLite) ─────────────────────────────────────────────────────
# Edge-native database — replaces Supabase for diagnosis history & feedback
# Get from: https://turso.tech/app
TURSO_DATABASE_URL=libsql://cabi-diagnosis-mithun.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# ── Optional: Vercel Deployment ───────────────────────────────────────────────
# VERCEL_URL=web.krishiai.live
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
