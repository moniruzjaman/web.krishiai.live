# ─────────────────────────────────────────────────────────────
# Krishi AI — Environment Variables
# Copy this file to .env.local for local development.
# In Vercel: add these under Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# PRIMARY — Google Gemini 2.0 Flash (free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# FALLBACK #1 — Groq (free tier: 14,400 RPD text / 1,000 RPD vision)
# Llama 3.3 70B (text) + Llama 4 Scout (vision)
# Get key at: https://console.groq.com/keys
# Significantly faster than OpenRouter cascade (~1s vs ~10s)
GROQ_API_KEY=your_groq_api_key_here

# FALLBACK #2 — OpenRouter (free vision models)
# Get key at: https://openrouter.ai/keys
# Only needed if Gemini + Groq both fail
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DISEASE VERIFIER — PlantNet (500 free requests/day)
# Used as secondary cross-verifier for crop disease image analysis
# Get key at: https://my.plantnet.org/account
PLANTNET_API_KEY=your_plantnet_api_key_here

# SENTRY — Error tracking (optional)
# DSN is public-by-design, bundled into client-side JS
# Get at: https://sentry.io/settings/<org>/projects/<project>/keys/
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# SENTRY — Auth token for source map uploads (build-time only, optional)
# Get at: https://sentry.io/settings/<org>/auth-tokens/
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# BUILD — Bundle analysis (set to "true" to generate stats.html)
# Usage: ANALYZE=true npm run build
ANALYZE=true

# BUILD — Suppress CJS deprecation warnings (used in Vercel build command)
VITE_CJS_IGNORE_WARNING=1

# SUPABASE — Read-only shared image access from your existing Supabase project
# All user data (profile, scans, chat, images) stays locally in IndexedDB.
# Supabase is used only to fetch shared reference disease images.
# URL: Project Settings → API → Project URL
# Anon Key: Project Settings → API → anon/public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────────────────────
# NOTES
# • All API keys are server-side only (used in api/*.js)
# • Never expose these in src/ or any client-side code
# • The app works without any keys (rule-based fallback active)
# • Cascade priority: Gemini → Groq → OpenRouter → rule-based
# • Sentry vars are optional — builds succeed without them
# • Supabase vars are optional (prefixed with VITE_) — app works offline-only without them
# ─────────────────────────────────────────────────────────────
