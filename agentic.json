{
  "$schema": "https://graphify.dev/schemas/agentic/v1",
  "name": "KrishiAI OpenProvider Orchestration",
  "version": "3.1.1",
  "description": "Central orchestrator that routes AI tasks across providers with quota-aware fallback chains, including CABI Plantwise diagnosis pipeline",
  "orchestrator": {
    "name": "OpenProvider",
    "module": "src/lib/openprovider.ts",
    "entry": "orchestrate()"
  },
  "agents": {
    "cline": {
      "role": "Schema & Migration",
      "description": "DB schema generation, migration planning, data modeling",
      "taskTypes": ["schema"],
      "preferredProvider": "gemini",
      "module": "src/lib/supabase/schema.sql"
    },
    "kilo": {
      "role": "Infrastructure & CI/CD",
      "description": "Infra setup, CI/CD pipelines, Docker configs, deployment checks",
      "taskTypes": ["infra"],
      "preferredProvider": "groq",
      "module": ".github/workflows/validate.yml"
    },
    "opencode": {
      "role": "Refactor & Environment",
      "description": "Code refactoring, environment variable injection, config updates",
      "taskTypes": ["refactor"],
      "preferredProvider": "gemini",
      "module": "next.config.ts"
    },
    "claude": {
      "role": "Validation & Compliance",
      "description": "Reasoning-heavy validation, compliance checks, quality assurance",
      "taskTypes": ["validation"],
      "preferredProvider": "gemini",
      "module": "src/lib/ai-client.ts"
    },
    "kimi": {
      "role": "Polish & Bilingual Formatting",
      "description": "Bengali-English bilingual formatting, presentation-ready outputs",
      "taskTypes": ["polish"],
      "preferredProvider": "groq",
      "module": "src/lib/cabi/bengaliKeywords.ts"
    },
    "zai": {
      "role": "Automation & Structured Content",
      "description": "Structured content generation, workflow automation, cloning",
      "taskTypes": ["automation"],
      "preferredProvider": "gemini",
      "module": "src/lib/openprovider.ts"
    },
    "cabi-diagnosis": {
      "role": "CABI Plantwise Diagnosis Orchestrator",
      "description": "CABI Plantwise disease diagnosis pipeline — multi-provider AI waterfall with exclusion gates, disease triangle, IPM recommendations. Adapts CABI diagnosis app patterns for KrishiAI.",
      "taskTypes": ["diagnose"],
      "preferredProvider": "gemini",
      "module": "src/app/api/diagnose/route.ts",
      "orchestration": {
        "source": "cabi-diagnosis",
        "sourceRepo": "https://github.com/moniruzjaman/cabi-diagnosis",
        "pipeline": [
          "normalize request format (messages or analyzer-page format)",
          "AI provider waterfall: Gemini vision → OpenRouter Qwen-VL → Groq Vision → OpenRouter text → Gemini text → Emergency fallback",
          "extract structured JSON from AI response",
          "return Bangla section + English section + structured diagnosis data"
        ],
        "systemPrompt": "Full CABI Plantwise Ready Reckoner with 6 parts: Diagnostic Protocol, Ready Reckoner Tables, Big 5 Recommendation Framework, FRAC/IRAC Resistance Management, Visual Analysis Protocol, Mandatory Output Format"
      }
    }
  },
  "providers": {
    "gemini": {
      "model": "gemini-2.5-flash",
      "apiKey": "GEMINI_API_KEY",
      "strengths": ["reasoning", "multimodal", "rich-content", "vision"],
      "freeTier": true,
      "priority": 1
    },
    "openrouter": {
      "model": "qwen/qwen2.5-vl-72b-instruct:free",
      "apiKey": "OPENROUTER_API_KEY",
      "strengths": ["vision", "wide-model-access", "free-tier"],
      "freeTier": true,
      "priority": 2
    },
    "groq": {
      "model": "llama-3.2-11b-vision-preview",
      "apiKey": "GROQ_API_KEY",
      "strengths": ["fast-text", "vision", "structured-output", "low-latency"],
      "freeTier": true,
      "priority": 3
    }
  },
  "taskRoutes": {
    "chat":           ["gemini", "openrouter", "groq"],
    "diagnose":       ["gemini", "openrouter", "groq"],
    "soil_analysis":  ["gemini", "groq"],
    "crop_database":  ["gemini", "openrouter"],
    "news_bulletin":  ["groq", "gemini"],
    "schema":         ["gemini"],
    "infra":          ["groq", "gemini"],
    "refactor":       ["gemini", "groq"],
    "validation":     ["gemini", "openrouter"],
    "polish":         ["groq", "gemini"],
    "automation":     ["gemini", "groq"]
  },
  "fallback": {
    "strategy": "waterfall",
    "offline": "Bengali graceful degradation message",
    "quotaExceeded": "Daily limit reached, try tomorrow",
    "diagnosisEmergency": "Keyword-based emergency diagnosis with CABI safe advice"
  },
  "deployment": {
    "platform": "vercel",
    "region": "hkg1",
    "framework": "nextjs-16",
    "runtime": "bun"
  },
  "monitoring": {
    "dashboard": "/dashboard",
    "apiEndpoints": {
      "status": "/api/dashboard/status",
      "usage": "/api/dashboard/usage",
      "deployments": "/api/dashboard/deployments"
    },
    "refreshInterval": "30s"
  },
  "graphify": {
    "visualization": ".agent/docs/orchestration.md",
    "index": ".agent/docs/INDEX.md"
  }
}
