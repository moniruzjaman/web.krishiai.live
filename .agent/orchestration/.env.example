# meta-mcp-hub — environment variables
# Copy to .env and fill in the values you need.

# --- PWA / app config ---
DATABASE_URL=
NEXTAUTH_SECRET=
API_KEY=

# --- Free-tier external models (routed via OpenProvider) ---
# Reasoning: openprovider picks Claude when intent is "reasoning"
# or capability "compliance-check" / "structured-analysis".
ANTHROPIC_API_KEY=

# Presentation: openprovider picks Kimi when intent is "presentation"
# or capability "polish" / "bilingual" / "report-formatting".
KIMI_API_KEY=

# Automation: openprovider picks Z.ai when intent is "automation"
# or capability "workflow-clone" / "pipeline-integration".
ZAI_API_KEY=
