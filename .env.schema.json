{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "GEMINI_API_KEY": {
      "type": "string",
      "description": "Google Gemini 2.0 Flash API key",
      "environments": ["local", "vercel"],
      "required": false,
      "secret": true
    },
    "OPENROUTER_API_KEY": {
      "type": "string",
      "description": "OpenRouter API key for free vision model fallback",
      "environments": ["local", "vercel"],
      "required": false,
      "secret": true
    },
    "VITE_SENTRY_DSN": {
      "type": "string",
      "description": "Sentry DSN for client-side error tracking (public-by-design)",
      "environments": ["local", "vercel"],
      "required": false,
      "secret": false
    },
    "SENTRY_AUTH_TOKEN": {
      "type": "string",
      "description": "Sentry auth token for source map uploads (build-time only)",
      "environments": ["local", "vercel", "ci"],
      "required": false,
      "secret": true
    },
    "ANALYZE": {
      "type": "string",
      "description": "Enables Vite bundle analysis (set to 'true' for stats.html)",
      "environments": ["local"],
      "required": false,
      "secret": false,
      "default": "true"
    },
    "VITE_CJS_IGNORE_WARNING": {
      "type": "string",
      "description": "Suppresses CJS deprecation warnings during Vite build",
      "environments": ["local", "vercel", "ci"],
      "required": false,
      "secret": false,
      "default": "1"
    }
  }
}
